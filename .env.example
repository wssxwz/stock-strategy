# Stock Strategy Trading System - Environment Configuration
# Copy this file to .env and fill in your values

# ========== API Keys ==========
ALPHA_VANTAGE_API_KEY="YOUR_API_KEY_HERE"
USE_YAHOO_FINANCE=1

# ========== Trading Mode ==========
TRADING_ENV=paper
LIVE_TRADING=NO
LIVE_SUBMIT=0

# ========== Risk Management ==========
MAX_OPEN_POS=1
MAX_NEW_BUYS_PER_DAY=1
MAX_PRICE_PCT_EQUITY=0.45
TOTAL_RISK_CAP=0.02
MIN_CASH_BUFFER_USD=50

# ========== Telegram Notifications ==========
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"
ALERT_CHAT_ID="YOUR_CHAT_ID_HERE"

# ========== Data Sources ==========
DATA_SOURCE_PRIORITY="yfinance,alpha_vantage"
DATA_CACHE_SECONDS=300

# ========== Scanning Parameters ==========
MIN_SCORE_THRESHOLD=70
REGIME_WINDOW_DAYS=20

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FILE="logs/trading.log"

# ========== Dashboard ==========
DASHBOARD_UPDATE_MINUTES=5
GITHUB_PAGES_URL="https://wssxwz.github.io/stock-strategy/"
